# Genere secretos aleatorios fuertes (>= 32 caracteres, distintos entre sí y sin
# el nombre del proyecto). Ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL="mysql://root:YOUR_DB_PASSWORD@localhost:3306/banquito_solidario?connection_limit=10&pool_timeout=10"
PORT=3000
JWT_SECRET=REPLACE_WITH_RANDOM_HEX_MIN_32_CHARS_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=REPLACE_WITH_OTHER_RANDOM_HEX_MIN_32_CHARS_BBBBBBBBBBBBBBBBBBBBBBBBBBB
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Detras de un proxy inverso (nginx/ALB) ponga TRUST_PROXY=1 para que req.ip y
# el rate limiting usen la IP real del cliente (cabecera X-Forwarded-For).
TRUST_PROXY=
